# ============================================================================
# feige-outbound-platform 环境变量示例
# 复制到 ~/.config/feige-outbound/env（0600），systemd unit 通过 EnvironmentFile 读取
# 也可直接 export（注意不要提交到 git / 不要出现在命令行历史）
# ============================================================================

# ---- AI 供应商密钥（必填）----
# MiniMax ASR（注意：key 区域必须与 baseUrl 匹配；CN key 用 api.minimax.cn，global key 用 api.minimax.io）
FOP_MINIMAX_API_KEY=sk-api-xxxxxxxxxxxxxxxxxxxxxxxx
# DeepSeek（AI 后处理）
FOP_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- 可选：服务监听 ----
# FOP_HOST=127.0.0.1
# FOP_PORT=8710

# ---- 可选：数据目录（默认 ~/.local/share/feige-outbound）----
# FOP_DATA_DIR=/home/<user>/.local/share/feige-outbound

# ---- 可选：模型覆盖 ----
# FOP_ASR_MODEL=asr-1.0
# FOP_ANALYSIS_MODEL=deepseek-chat

# ---- 可选：配置目录（默认 ~/.config/feige-outbound）----
# FOP_CONFIG_DIR=/home/<user>/.config/feige-outbound

# ---- 可选：日志级别（debug|info|warn|error）----
# FOP_LOG_LEVEL=info

# ---- 可选：CLI 使用（非服务进程）----
# FOP_API_URL=http://127.0.0.1:8710/api/v1
# FOP_API_TOKEN=<~/.config/feige-outbound/api-token 内容>
# FOP_API_TOKEN_FILE=/home/<user>/.config/feige-outbound/api-token

# ---- 可选：OpenAPI 契约文件路径（默认自动探测 spec/openapi.yaml）----
# FOP_OPENAPI_FILE=/path/to/spec/openapi.yaml
