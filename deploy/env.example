# feige-outbound-platform 环境变量（复制到 ~/.config/feige-outbound/env，权限 0600）
# MiniMax ASR 密钥（必填，用于本地转写）
FOP_MINIMAX_API_KEY=sk-api-xxxxxxxxxxxxxxxx
# DeepSeek 密钥（必填，用于 AI 后处理）
FOP_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 可选：覆盖模型/端口/数据目录/日志级别
# FOP_ASR_MODEL=asr-1.0
# FOP_ANALYSIS_MODEL=deepseek-chat
# FOP_PORT=8710
# FOP_HOST=127.0.0.1
# FOP_DATA_DIR=/home/<user>/.local/share/feige-outbound
# FOP_LOG_LEVEL=info
# FOP_UPSTREAM_BASE_URL=https://feige.duofangtongxin.com/duofang-feige-admin
